# Telegram MTProto API (من موقع my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=abcdef0123456789abcdef0123456789

# Telegram Bot Token (لبوت الإشعارات وإدارة القنوات عبر BotFather)
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# معرّف حسابك الخاص لاستلام الإشعارات والتحكم بالبوت (Chat ID)
ADMIN_CHAT_ID=987654321

# القنوات تُضاف من لوحة الويب أو بالأمر /add (هذا الحقل اختياري لقنوات أولية فقط)
SOURCE_CHANNELS=

# منفذ لوحة التحكم الويب (بعض الاستضافات تحدد المتغير PORT تلقائياً ويُستخدم بدلاً منه)
WEB_PORT=5000
WEB_HOST=127.0.0.1

# اسم المستخدم وكلمة مرور لوحة الويب (ضرورية عند الرفع على استضافة عامة)
PANEL_USERNAME=admin
PANEL_PASSWORD=

# بوت الفحص الشرعي يُحدد من لوحة الويب أو بالأمر /bot @اسم_البوت
# مهلة انتظار رد البوت بالثواني ومدة حفظ أحكامه بالأيام
HALAL_BOT_TIMEOUT=30
HALAL_CACHE_DAYS=7
# كلمات اختيارية لتخصيص قراءة رد البوت (مفصولة بفاصلة)
# HALAL_KEYWORDS=مباح,حلال,halal
# HARAM_KEYWORDS=محرم,حرام,haram

# مفاتيح Binance API (اختياري)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# مسح جميع رسائل اليوم ثلاث مرات يومياً بتوقيت الرياض
DAILY_SCAN_ENABLED=true
APP_TIMEZONE=Asia/Riyadh
DAILY_SCAN_TIMES=08:00,14:00,20:00
